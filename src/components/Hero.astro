---
const { items = [] } = Astro.props;
---
<section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-blue-50 to-white -z-10"></div>
    <div class="container mx-auto px-6">
        <div class="flex flex-col lg:flex-row items-center gap-12">
            <div class="lg:w-1/2 text-center lg:text-left">
                <h1 class="text-4xl lg:text-6xl font-bold leading-tight mb-6 text-gray-900">
                    Don’t let complex technical hurdles keep you from <span class="text-primary">success</span>
                </h1>
                <p class="text-xl text-gray-600 mb-8 leading-relaxed">
                    Focus on Building Your Business and let us deal with the necessary but often time consuming tech related hassles that come with doing business in today&#8217;s fast paced world.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                    <a href="#contact" class="px-8 py-4 bg-primary hover:bg-blue-600 text-white font-bold rounded-lg shadow-lg hover:shadow-blue-500/40 transition-all transform hover:-translate-y-1">
                        GET STARTED
                    </a>
                    <a href="#contact" class="px-8 py-4 bg-white border-2 border-gray-100 hover:border-primary/30 text-gray-700 font-bold rounded-lg hover:bg-gray-50 transition-all">
                        Book A Call
                    </a>
                </div>
            </div>
            <div class="lg:w-1/2">
                <img src="https://essentialtechhelp.com/wp-content/uploads/2023/01/computer.png" alt="Tech Success" class="w-full max-w-lg mx-auto drop-shadow-2xl animate-fade-in-up" />
            </div>
        </div>
    </div>
</section>
