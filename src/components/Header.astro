---
const { items = [
    { label: "Home", href: "#" },
    { label: "Services", href: "#services" },
    { label: "Work", href: "#work" },
    { label: "Blog", href: "#blog" },
] } = Astro.props;
---
<header class="fixed w-full z-50 bg-white/90 backdrop-blur-md shadow-sm transition-all duration-300">
    <div class="container mx-auto px-6 py-4 flex justify-between items-center">
        <a href="/" class="flex items-center">
            <img src="https://essentialtechhelp.com/wp-content/uploads/2023/01/Essential-Tech-Help-Logo-500-%C3%97-150-px.png" alt="Essential Tech Help" class="h-12 w-auto" />
        </a>
        
        <nav class="hidden md:flex space-x-8">
            {items.map(item => (
                <a href={item.href} class="text-gray-600 hover:text-primary font-medium transition-colors">
                    {item.label}
                </a>
            ))}
        </nav>

        <a href="#contact" class="hidden md:inline-flex items-center px-6 py-2.5 bg-primary hover:bg-blue-600 text-white font-semibold rounded-full transition-all transform hover:scale-105 shadow-lg hover:shadow-blue-500/30">
            Book A Call
        </a>

        <!-- Mobile Menu Button -->
        <button class="md:hidden text-gray-600" aria-label="Open Menu">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
        </button>
    </div>
</header>
