---
const { items = [] } = Astro.props;
---
<section class="py-20 bg-gray-900 text-white" id="work">
    <div class="container mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-12">
            <div class="group cursor-pointer">
                <div class="overflow-hidden rounded-xl mb-6 shadow-2xl border-4 border-gray-800 group-hover:border-primary transition-all">
                    <img src="https://essentialtechhelp.com/wp-content/uploads/2023/01/2-1.png" alt="Challenge Launch Toolkit" class="w-full h-auto transform group-hover:scale-105 transition-transform duration-500" />
                </div>
                <h3 class="text-2xl font-bold mb-2 group-hover:text-primary transition-colors">Check out our work on ChallengeLaunchToolkit.com</h3>
            </div>
            <div class="group cursor-pointer">
                <div class="overflow-hidden rounded-xl mb-6 shadow-2xl border-4 border-gray-800 group-hover:border-secondary transition-all">
                    <img src="https://essentialtechhelp.com/wp-content/uploads/2023/01/4-1.png" alt="Digital Wayfinders" class="w-full h-auto transform group-hover:scale-105 transition-transform duration-500" />
                </div>
                <h3 class="text-2xl font-bold mb-2 group-hover:text-secondary transition-colors">Check out our work on DigitalWayfinders.com</h3>
            </div>
        </div>
    </div>
</section>
