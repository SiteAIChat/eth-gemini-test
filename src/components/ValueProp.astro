---
const { items = [] } = Astro.props;
---
<section class="py-20 bg-gray-50">
    <div class="container mx-auto px-6">
         <div class="flex flex-col-reverse md:flex-row items-center gap-12">
            <div class="md:w-1/2">
                <h2 class="text-3xl lg:text-4xl font-bold mb-6">Do What You Do Best We'll Handle The Rest</h2>
                <p class="text-lg text-gray-600 mb-8 leading-relaxed">
                    You don&#8217;t need to waste your time banging your head against a wall trying to figure out how to get your technology to work together. We supply the tools and support you need at a low monthly price.
                </p>
                <a href="#contact" class="inline-block px-8 py-3 bg-secondary hover:bg-purple-600 text-white font-bold rounded-lg shadow-md transition-all">
                    Get Support Now
                </a>
            </div>
             <div class="md:w-1/2">
                 <img src="https://essentialtechhelp.com/wp-content/uploads/2023/01/003-web-programming.png" alt="Web Programming" class="w-full max-w-md mx-auto" />
            </div>
         </div>
    </div>
</section>
